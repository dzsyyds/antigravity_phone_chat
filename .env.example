# ==============================================
# Antigravity 掌上控制台 - 环境变量配置模板
# 复制本文件为 .env 后按需修改（.env 已被 git 忽略）
# ==============================================

# 手机访问鉴权口令（公网穿透访问时强烈建议修改默认密码！）
APP_PASSWORD=123456

# 本地 Web 服务监听端口（默认 3000）
PORT=3000

# ==============================================
# 公网穿透方案（国内网络推荐 Cpolar；海外可选 ngrok）
# ==============================================

# 1. Cpolar（国内直连稳定，推荐搭配 Clash Verge TUN 规则模式）
# 守护启动脚本 daemon_launcher.mjs 会自动启动 cpolar；若购买了固定子域名可填写下方字段：
# CPOLAR_REGION=cn_top
# CPOLAR_SUBDOMAIN=你的固定子域名
# CPOLAR_PATH=c:\path\to\cpolar.exe

# 2. ngrok（可选，需自备 Authtoken）
# NGROK_AUTHTOKEN=你的_ngrok_token
# NGROK_DOMAIN=你的静态域名.ngrok-free.app

# ==============================================
# 可选：Gemini 云端语音转文字增强（手机语音输入 / Live 模式兜底）
# 若国内手机浏览器自带语音识别不可用，配置后将自动启用录音上传 Gemini 转写
# ==============================================
# GEMINI_API_KEY=你的_gemini_api_key
